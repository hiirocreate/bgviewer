<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- BGRecorder側で定義されたsignature権限。同じ鍵で署名されている場合のみ自動付与される -->
    <uses-permission android:name="com.hono.bgrecorder.permission.ACCESS_RECORDINGS" />

    <!-- Android 11+のパッケージ可視性対応：BGRecorderがインストールされているか判定するために必要 -->
    <queries>
        <package android:name="com.hono.bgrecorder" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.BGViewer"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.BGViewer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          再生画面はFLAG_SECUREを使うため、他アプリによるスクリーンショット・画面録画からも保護される。
          exported=falseなので他アプリから直接起動もできない。
        -->
        <activity
            android:name=".PlayerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.BGViewer" />

    </application>
</manifest>
